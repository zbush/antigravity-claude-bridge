{
  "mcpServers": {
    "claude-local": {
      "command": "node",
      "args": [
        "server/index.mjs"
      ],
      "env": {
        "AGENT_BRIDGE_ROLE": "subordinate",
        "AGENT_BRIDGE_MAX_DEPTH": "0",
        "AGENT_BRIDGE_HIDE_RESTRICTED_TOOLS": "true",
        "AGENT_BRIDGE_CALLBACK_DISALLOWED_TOOLS": "mcp__antigravity-local__*,mcp__antigravity__*"
      }
    }
  }
}
